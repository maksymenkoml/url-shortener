{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noEmit": false,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "strict": false
    }
  },
  "include": [
    "src/**/*",
    "src/types/**/*.d.ts"
  ]
}